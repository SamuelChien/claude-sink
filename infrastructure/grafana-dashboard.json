{
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "title": "Is Data Flowing?",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "title": "Events Written (last 15m)",
      "description": "Messages produced to each topic in the last 15 minutes. Zero = no data flowing in.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 1 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "sum(increase(kafka_topic_partition_current_offset{topic=\"sink.skills\"}[15m]))", "legendFormat": "skills" },
        { "expr": "sum(increase(kafka_topic_partition_current_offset{topic=\"sink.sessions\"}[15m]))", "legendFormat": "sessions" },
        { "expr": "sum(increase(kafka_topic_partition_current_offset{topic=\"sink.code\"}[15m]))", "legendFormat": "code" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
          "noValue": "0"
        }
      },
      "options": { "colorMode": "background", "textMode": "value_and_name", "graphMode": "area" }
    },
    {
      "title": "Events Consumed (last 15m)",
      "description": "Messages consumed by each processor in the last 15 minutes. Zero = consumers idle or stalled.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 1 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "sum(increase(kafka_consumergroup_current_offset{consumergroup=\"sink-skills-processor\"}[15m]))", "legendFormat": "skills" },
        { "expr": "sum(increase(kafka_consumergroup_current_offset{consumergroup=\"sink-sessions-processor\"}[15m]))", "legendFormat": "sessions" },
        { "expr": "sum(increase(kafka_consumergroup_current_offset{consumergroup=\"sink-code-processor\"}[15m]))", "legendFormat": "code" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
          "noValue": "0"
        }
      },
      "options": { "colorMode": "background", "textMode": "value_and_name", "graphMode": "area" }
    },
    {
      "title": "Consumer Lag NOW",
      "description": "Messages waiting to be consumed. Zero = caught up. Growing = consumers falling behind.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 1 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "kafka_consumergroup_lag_sum{consumergroup=\"sink-skills-processor\",topic=\"sink.skills\"}", "legendFormat": "skills lag" },
        { "expr": "kafka_consumergroup_lag_sum{consumergroup=\"sink-sessions-processor\",topic=\"sink.sessions\"}", "legendFormat": "sessions lag" },
        { "expr": "kafka_consumergroup_lag_sum{consumergroup=\"sink-code-processor\",topic=\"sink.code\"}", "legendFormat": "code lag" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 100 }] },
          "noValue": "0"
        }
      },
      "options": { "colorMode": "background", "textMode": "value_and_name", "graphMode": "none" }
    },
    {
      "title": "Write & Consume Rate",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "collapsed": false
    },
    {
      "title": "Produce Rate (events/min)",
      "description": "How fast events are being written to each raw topic. Spikes = active ingestion runs.",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 7 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "sum(rate(kafka_topic_partition_current_offset{topic=\"sink.skills\"}[5m])) * 60", "legendFormat": "sink.skills" },
        { "expr": "sum(rate(kafka_topic_partition_current_offset{topic=\"sink.sessions\"}[5m])) * 60", "legendFormat": "sink.sessions" },
        { "expr": "sum(rate(kafka_topic_partition_current_offset{topic=\"sink.code\"}[5m])) * 60", "legendFormat": "sink.code" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 25, "lineWidth": 2, "spanNulls": true, "stacking": { "mode": "none" } },
          "unit": "evt/min"
        }
      }
    },
    {
      "title": "Consume Rate (events/min)",
      "description": "How fast consumers are processing events. Should track produce rate. Flat = consumers idle.",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 7 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "sum(rate(kafka_consumergroup_current_offset{consumergroup=\"sink-skills-processor\"}[5m])) * 60", "legendFormat": "skills-consumer" },
        { "expr": "sum(rate(kafka_consumergroup_current_offset{consumergroup=\"sink-sessions-processor\"}[5m])) * 60", "legendFormat": "sessions-consumer" },
        { "expr": "sum(rate(kafka_consumergroup_current_offset{consumergroup=\"sink-code-processor\"}[5m])) * 60", "legendFormat": "code-consumer" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 25, "lineWidth": 2, "spanNulls": true },
          "unit": "evt/min"
        }
      }
    },
    {
      "title": "Lag Over Time",
      "description": "Consumer lag trending. Decreasing = catching up. Increasing = falling behind. Flat at zero = healthy.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "kafka_consumergroup_lag_sum{consumergroup=\"sink-skills-processor\",topic=\"sink.skills\"}", "legendFormat": "skills" },
        { "expr": "kafka_consumergroup_lag_sum{consumergroup=\"sink-sessions-processor\",topic=\"sink.sessions\"}", "legendFormat": "sessions" },
        { "expr": "kafka_consumergroup_lag_sum{consumergroup=\"sink-code-processor\",topic=\"sink.code\"}", "legendFormat": "code" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 15, "lineWidth": 2, "spanNulls": true, "thresholdsStyle": { "mode": "line" } },
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 100 }, { "color": "red", "value": 1000 }] }
        }
      }
    },
    {
      "title": "Analyzed Output",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "collapsed": false
    },
    {
      "title": "Analyzed Output Rate (events/min)",
      "description": "Rate of enriched messages being written to .analyzed topics. Should mirror consume rate.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 25 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "sum(rate(kafka_topic_partition_current_offset{topic=\"sink.skills.analyzed\"}[5m])) * 60", "legendFormat": "skills.analyzed" },
        { "expr": "sum(rate(kafka_topic_partition_current_offset{topic=\"sink.sessions.analyzed\"}[5m])) * 60", "legendFormat": "sessions.analyzed" },
        { "expr": "sum(rate(kafka_topic_partition_current_offset{topic=\"sink.code.analyzed\"}[5m])) * 60", "legendFormat": "code.analyzed" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 25, "lineWidth": 2, "spanNulls": true },
          "unit": "evt/min"
        }
      }
    },
    {
      "title": "DLQ Events (total)",
      "description": "Failed messages sent to dead-letter queues. Any non-zero value needs investigation.",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 25 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "sum(kafka_topic_partition_current_offset{topic=\"sink.skills.dlq\"})", "legendFormat": "skills DLQ" },
        { "expr": "sum(kafka_topic_partition_current_offset{topic=\"sink.sessions.dlq\"})", "legendFormat": "sessions DLQ" },
        { "expr": "sum(kafka_topic_partition_current_offset{topic=\"sink.code.dlq\"})", "legendFormat": "code DLQ" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 10 }] },
          "noValue": "0"
        }
      },
      "options": { "colorMode": "background", "textMode": "value_and_name", "graphMode": "area" }
    },
    {
      "title": "Pipeline Totals",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 },
      "collapsed": false
    },
    {
      "title": "Pipeline Coverage (%)",
      "description": "What percentage of raw events have been analyzed. 100% = fully caught up.",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 34 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "(sum(kafka_topic_partition_current_offset{topic=\"sink.skills.analyzed\"}) / sum(kafka_topic_partition_current_offset{topic=\"sink.skills\"})) * 100", "legendFormat": "skills" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 80 }, { "color": "green", "value": 99 }] }
        }
      }
    },
    {
      "title": "Pipeline Coverage (%)",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 34 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "(sum(kafka_topic_partition_current_offset{topic=\"sink.sessions.analyzed\"}) / sum(kafka_topic_partition_current_offset{topic=\"sink.sessions\"})) * 100", "legendFormat": "sessions" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 80 }, { "color": "green", "value": 99 }] }
        }
      }
    },
    {
      "title": "Pipeline Coverage (%)",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 34 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "(sum(kafka_topic_partition_current_offset{topic=\"sink.code.analyzed\"}) / sum(kafka_topic_partition_current_offset{topic=\"sink.code\"})) * 100", "legendFormat": "code" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 80 }, { "color": "green", "value": 99 }] }
        }
      }
    }
  ],
  "schemaVersion": 39,
  "tags": ["kafka", "claude-sink"],
  "time": { "from": "now-1h", "to": "now" },
  "title": "Claude Sink — Kafka Ingestion Health",
  "uid": "claude-sink-kafka-health",
  "version": 2,
  "refresh": "15s"
}
