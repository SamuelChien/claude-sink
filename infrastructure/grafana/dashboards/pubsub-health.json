{
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "title": "Is Data Flowing?",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "title": "Messages Published (last 15m)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 1 },
      "datasource": {"type": "stackdriver", "uid": "gcp-monitoring"},
      "targets": [
        { "queryType": "metrics", "metricQuery": { "metricType": "pubsub.googleapis.com/topic/send_message_operation_count", "filters": ["resource.label.topic_id", "=~", "sink-.*"], "crossSeriesReducer": "REDUCE_SUM", "perSeriesAligner": "ALIGN_DELTA", "alignmentPeriod": "900s", "groupBys": ["resource.label.topic_id"] } }
      ],
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "noValue": "0" } },
      "options": { "colorMode": "background", "textMode": "value_and_name", "graphMode": "area" }
    },
    {
      "title": "Messages Delivered (last 15m)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 1 },
      "datasource": {"type": "stackdriver", "uid": "gcp-monitoring"},
      "targets": [
        { "queryType": "metrics", "metricQuery": { "metricType": "pubsub.googleapis.com/subscription/pull_message_operation_count", "filters": ["resource.label.subscription_id", "=~", "sink-.*"], "crossSeriesReducer": "REDUCE_SUM", "perSeriesAligner": "ALIGN_DELTA", "alignmentPeriod": "900s", "groupBys": ["resource.label.subscription_id"] } }
      ],
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "noValue": "0" } },
      "options": { "colorMode": "background", "textMode": "value_and_name", "graphMode": "area" }
    },
    {
      "title": "Undelivered Messages (backlog)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 1 },
      "datasource": {"type": "stackdriver", "uid": "gcp-monitoring"},
      "targets": [
        { "queryType": "metrics", "metricQuery": { "metricType": "pubsub.googleapis.com/subscription/num_undelivered_messages", "filters": ["resource.label.subscription_id", "=~", "sink-.*"], "crossSeriesReducer": "REDUCE_SUM", "perSeriesAligner": "ALIGN_MEAN", "alignmentPeriod": "60s", "groupBys": ["resource.label.subscription_id"] } }
      ],
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 100 }] }, "noValue": "0" } },
      "options": { "colorMode": "background", "textMode": "value_and_name", "graphMode": "none" }
    },
    {
      "title": "Publish & Consume Rate",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 }
    },
    {
      "title": "Publish Rate (messages/min)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 7 },
      "datasource": {"type": "stackdriver", "uid": "gcp-monitoring"},
      "targets": [
        { "queryType": "metrics", "metricQuery": { "metricType": "pubsub.googleapis.com/topic/send_message_operation_count", "filters": ["resource.label.topic_id", "=~", "sink-(skills|sessions|code)"], "crossSeriesReducer": "REDUCE_SUM", "perSeriesAligner": "ALIGN_RATE", "alignmentPeriod": "60s", "groupBys": ["resource.label.topic_id"] } }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 25, "lineWidth": 2, "spanNulls": true }, "unit": "msg/min" } }
    },
    {
      "title": "Consume Rate (ack messages/min)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 7 },
      "datasource": {"type": "stackdriver", "uid": "gcp-monitoring"},
      "targets": [
        { "queryType": "metrics", "metricQuery": { "metricType": "pubsub.googleapis.com/subscription/ack_message_operation_count", "filters": ["resource.label.subscription_id", "=~", "sink-.*-processor"], "crossSeriesReducer": "REDUCE_SUM", "perSeriesAligner": "ALIGN_RATE", "alignmentPeriod": "60s", "groupBys": ["resource.label.subscription_id"] } }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 25, "lineWidth": 2, "spanNulls": true }, "unit": "msg/min" } }
    },
    {
      "title": "Backlog Over Time",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 }
    },
    {
      "title": "Undelivered Messages (backlog trend)",
