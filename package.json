{
  "name": "claude-sink",
  "version": "0.1.0",
  "description": "CLI tool to ingest skills, Claude sessions, and code into Kafka topics",
  "bin": {
    "claude-sink": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "infra:up": "docker compose -f infrastructure/docker-compose.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker-compose.yml down"
  },
  "files": [
    "dist/"
  ],
  "dependencies": {
    "@google-cloud/pubsub": "^5.3.0",
    "commander": "^12.1.0",
    "express": "^5.2.1",
    "glob": "^10.3.10",
    "js-yaml": "^4.1.0",
    "kafkajs": "^2.2.4",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
